# コピーして利用: cp .env.example .env
# 初回は php artisan key:generate を実行して APP_KEY を生成してください。

APP_NAME=ミセチョク
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_KEY=

# ASSET_URL=

# 運営（管理者）ログインの URL パス
# /admin/login のような予測可能な URL を避けるため、環境ごとに固有の
# ランダム文字列を設定する。名前付きルート admin.login は変わらないので
# 参照コード側の変更は不要。デプロイ時は必ず本番用に差し替えること。
# ADMIN_LOGIN_PATH=staff-portal-a7k92pf

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# DATABASE_URL=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# メール（SendGrid SMTP 等。未使用なら MAIL_MAILER=log など）
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@misechoku.jp
MAIL_FROM_NAME="${APP_NAME}"

# SendGrid API（アプリ外ツールや将来の拡張用。未使用なら空で可）
SENDGRID_API_KEY=

# LINE ログイン・Messaging API（config/services.php）
#
# 【LINE Login】LINE Developers → 該当チャネル → LINE Login タブ → コールバック URL に例:
#   https://あなたのドメイン/login/line/callback
# （Messaging API の Webhook URL とは別です。ここを Webhook にすると redirect_uri エラーになります）
#
# LINE_REDIRECT_URI を空にすると、実際のリクエストの https とドメインからコールバックURLを組み立てる。
# 明示する場合は上記と完全一致（末尾スラッシュ含む）にすること。
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI="${APP_URL}/login/line/callback"
#
# 【Messaging API】同じチャネル（またはリンクしたチャネル）の Channel secret / token。
# Webhook URL には例: https://あなたのドメイン/line/webhook （POST のみ、本アプリが 200 を返す）
# 検証で 401 になる場合はリバプロのベーシック認証・WAF・別 URL 誤指定を疑う（Laravel では通常 400/503）。
LINE_MESSAGE_CHANNEL_ID=
LINE_MESSAGE_CHANNEL_SECRET=
LINE_MESSAGE_CHANNEL_TOKEN=

# LINE Notify 連携（レガシー用。未使用なら空で可）
LINE_NOTIFY_CLIENT_ID=
LINE_NOTIFY_CLIENT_SECRET=
LINE_NOTIFY_CALLBACK_URL="${APP_URL}/line-notify/callback"

GOOGLE_MAP_API=
# GOOGLE_MAP_API_IP=

# Web Push（php artisan push:vapid で生成）
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# ============================================================
# AI コンシェルジュ（LLM 連携）
# ============================================================
#
# キャストの「AI レコメンド」自由入力チャットで、対話文の生成に
# OpenAI 互換の Chat Completions API を使用する。
# LLM_PROVIDER が 'template' の場合は連携せずテンプレ返答のみ（既定・無料）。
#
#  ● Groq（推奨・無料枠が広い OSS モデルホスティング）
#     1. https://console.groq.com にサインアップ（GitHub 等でログイン）
#     2. https://console.groq.com/keys で API キーを発行
#     3. .env に下記を設定:
#          LLM_PROVIDER=openai_compat
#          LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
#          LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
#          LLM_MODEL=llama-3.3-70b-versatile
#     推奨モデル:
#       llama-3.3-70b-versatile   ... 日本語○・応答品質高い
#       qwen-2.5-32b-instruct     ... 日本語◎（少し重い）
#       llama-3.1-8b-instant      ... 超高速だが日本語やや弱い
#
#  ● Ollama（ローカル / セルフホスト・API キー不要）
#     1. ollama pull qwen2.5:7b-instruct  等でモデルを取得
#     2. ollama serve でサービス起動
#     3. .env:
#          LLM_PROVIDER=openai_compat
#          LLM_ENDPOINT=http://localhost:11434/v1/chat/completions
#          LLM_API_KEY=
#          LLM_MODEL=qwen2.5:7b-instruct
#
#  ● Together AI / OpenRouter 等の他 OSS モデルホスティング
#     Chat Completions 互換ならエンドポイントとキーを差し替えるだけで動く。
#
# LLM_FALLBACK=true の場合、LLM 呼び出しが失敗しても
# AiChatTemplateService の日本語テンプレ返答に自動フォールバック。
LLM_PROVIDER=template
LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=350
LLM_TEMPERATURE=0.75
LLM_TIMEOUT=15
LLM_HISTORY_TURNS=6
LLM_FALLBACK=true
